{
  "name": "dsh-deepblue-hud",
  "version": "0.2.0",
  "description": "Deep blue cockpit HUD for DeepSeek Harness: session economy, system vitals and a linear tool trajectory, docked bottom-right of the Web UI.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "icon.svg"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "hud",
    "cockpit",
    "monitor",
    "theme"
  ],
  "license": "MIT",
  "author": "Zhang-Zhibo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zzricls/dsh-deepblue-hud.git"
  },
  "homepage": "https://github.com/zzricls/dsh-deepblue-hud#readme",
  "bugs": {
    "url": "https://github.com/zzricls/dsh-deepblue-hud/issues"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "Deep Blue Cockpit HUD",
    "description": "A collapsible deep-blue cockpit overlay: session economy, system vitals and tool trajectory."
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsdown && node scripts/fix-client-map.mjs",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify": "tsc --noEmit && tsdown && node scripts/fix-client-map.mjs && node scripts/smoke.mjs",
    "prepublishOnly": "npm run verify"
  }
}
